// 15-validator devnet config, scaled up from benchmark-5val.jsonnet.
//
// Validators/mnemonic placeholders are generated by loop instead of hand-copied
// (5val's approach) since 15 entries of the same shape is unmaintainable by hand.
// Add VALIDATOR1_MNEMONIC..VALIDATOR15_MNEMONIC to scripts/.env before running.
//
// Tuning (mempool size, consensus timeouts, libp2p limits, block gas) is
// carried over unchanged from 5val's measured values - none of it has been
// re-measured at 15 validators. Block propagation across 15 hosts inside the
// same round timeouts is the thing most likely to need retuning; watch for
// stalls/slow rounds before trusting throughput numbers from this config.
local num_validators = 15;

local validator(i) = {
  coins: '1000000000000000000stake,10000000000000000000000basetcro',
  staked: '1000000000000000000stake',
  mnemonic: '${VALIDATOR%d_MNEMONIC}' % (i + 1),
  client_config: {
    'broadcast-mode': 'sync',
  },
  config: {
    // base_port+9 is unused by pystarport's own port scheme (ports.py
    // allocates +0..+8), so it's free to claim per node for Prometheus -
    // node0 26659, node1 26669, ... nodeN 26650+i*10+9. Needed because the
    // shared instrumentation.prometheus block below sets ':9090' identically
    // for every node, but pystarport puts all validators on 127.0.0.1 with
    // only the port varying, so only one node's metrics would otherwise bind.
    instrumentation: { prometheus_listen_addr: ':%d' % (26650 + i * 10 + 9) },
  },
};

{
  dotenv: '../../../../scripts/.env',
  'cronos_777-1': {
    cmd: 'cronosd',
    'start-flags': '--trace --async-check-tx',
    config: {
      db_backend: 'rocksdb',
      event_bus_buffer_capacity: 128,
      rpc: {
        'max_open_connections': 10000,
      },
      mempool: {
        size: 100000,
        recheck: true,
        type: 'app',
        broadcast: true,
        reap_max_gas: 210000000,
        reap_interval: '500ms',
      },
      consensus: {
        timeout_propose: '3s',
        timeout_propose_delta: '500ms',
        timeout_prevote: '1s',
        timeout_prevote_delta: '500ms',
        timeout_precommit: '1s',
        timeout_precommit_delta: '500ms',
        timeout_commit: '200ms',
        create_empty_blocks_interval: '5s',
        peer_gossip_sleep_duration: '100ms',
        peer_query_maj23_sleep_duration: '2s',
        skip_timeout_commit: false,
      },
      tx_index: {
        indexer: 'null',
      },
      instrumentation: {
        prometheus: true,
        prometheus_listen_addr: ':9090',
      },
      p2p: {
        libp2p: {
          enabled: true,
          limits: {
            mode: 'custom',
            // 14 peers at full mesh + headroom - max_peers gates ALL conns
            // (inbound/outbound/dial) with no exemption for bootstrap/
            // unconditional peers, so 16 leaves zero slack for an observer
            // or a 16th host.
            max_peers: 24,
            max_peer_streams: 256,
          },
        },
      },
    },
    'app-config': {
      chain_id: 'cronos_777-1',
      'app-db-backend': 'rocksdb',
      'minimum-gas-prices': '0basetcro',
      'index-events': ['ethereum_tx.ethereumTxHash'],
      'iavl-lazy-loading': true,
      'async-check-tx': true,
      'json-rpc': {
        address: '127.0.0.1:{EVMRPC_PORT}',
        'ws-address': '127.0.0.1:{EVMRPC_PORT_WS}',
        api: 'eth,net,web3,debug,cronos',
        'feehistory-cap': 100,
        'block-range-cap': 10000,
        'logs-cap': 10000,
        'enable-indexer': false,
      },
      mempool: {
        'max-txs': 320000,
      },
      telemetry: {
        enabled: true,
        'prometheus-retention-time': 60,
      },
      evm: {
        'block-executor': 'block-stm',
        'block-stm-workers': 0,
        'block-stm-pre-estimate': false,
      },
      memiavl: {
        enable: true,
        'zero-copy': true,
        'snapshot-interval': 5,
        'cache-size': 1000,
        'async-commit-buffer': 0,
      },
      grpc: {
        'skip-check-header': true,
      },
      cronos: {
        'mempool-txs-per-block': 10000,
        'tx-cache-size': 100000,
      },
    },
    validators: [validator(i) for i in std.range(0, num_validators - 1)],
    accounts: [
      {
        name: 'community',
        coins: '1000000000000000000000000000basetcro',
        mnemonic: '${COMMUNITY_MNEMONIC}',
      },
      {
        name: 'signer1',
        coins: '20000000000000000000000basetcro',
        mnemonic: '${SIGNER1_MNEMONIC}',
      },
      {
        name: 'signer2',
        coins: '30000000000000000000000basetcro',
        mnemonic: '${SIGNER2_MNEMONIC}',
      },
    ],
    genesis: {
      consensus: {
        params: {
          block: {
            max_gas: '210000000',
          },
        },
      },
      app_state: {
        evm: {
          params: {
            evm_denom: 'basetcro',
          },
        },
        cronos: {
          params: {
            cronos_admin: '${CRONOS_ADMIN}',
            enable_auto_deployment: true,
            ibc_cro_denom: '${IBC_CRO_DENOM}',
          },
        },
        gov: {
          params: {
            expedited_voting_period: '1s',
            voting_period: '10s',
            max_deposit_period: '10s',
            min_deposit: [
              {
                denom: 'basetcro',
                amount: '1',
              },
            ],
          },
        },
        transfer: {
          params: {
            receive_enabled: true,
            send_enabled: true,
          },
        },
        feemarket: {
          params: {
            no_base_fee: true,
            base_fee: '100000000000',
          },
        },
      },
    },
  },
}
