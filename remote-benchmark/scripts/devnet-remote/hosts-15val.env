# Node -> host mapping for the 15-validator remote devnet benchmark.
# TEMPLATE: NODE_PUBLIC_IPS / NODE_PRIVATE_IPS below are placeholders — fill
# in with the 15 real host IPs before use. Index order matches pystarport's
# node0..node14.
#
# node0 is deliberately the binary-owning host: genesis init and the
# largest local file operations (patch_erc20_genesis.py output, tar/gzip)
# stay on the box that already has both cronosd builds.

NODE_PUBLIC_IPS=(REPLACE_ME_0 REPLACE_ME_1 REPLACE_ME_2 REPLACE_ME_3 REPLACE_ME_4 REPLACE_ME_5 REPLACE_ME_6 REPLACE_ME_7 REPLACE_ME_8 REPLACE_ME_9 REPLACE_ME_10 REPLACE_ME_11 REPLACE_ME_12 REPLACE_ME_13 REPLACE_ME_14)
NODE_PRIVATE_IPS=(REPLACE_ME_0 REPLACE_ME_1 REPLACE_ME_2 REPLACE_ME_3 REPLACE_ME_4 REPLACE_ME_5 REPLACE_ME_6 REPLACE_ME_7 REPLACE_ME_8 REPLACE_ME_9 REPLACE_ME_10 REPLACE_ME_11 REPLACE_ME_12 REPLACE_ME_13 REPLACE_ME_14)

BASE_PORT=26650
SSH_USER=ubuntu
SSH_KEY="${SSH_KEY:-$HOME/.ssh/id_rsa}"
REMOTE_ROOT=/home/ubuntu/remote-devnet

# node1's existing binary paths (copy-only sources, never modified).
NODE1_V178_BIN=/home/ubuntu/jay/cronos_1.7.8-unsafe/bin/cronosd
NODE1_V180A_BIN=/home/ubuntu/jay/cronos/build/cronosd
NODE1_ROCKSDB_LIB=/lib/librocksdb.so.10.10.1
NODE1_SNAPPY_LIB=/lib/aarch64-linux-gnu/libsnappy.so.1

ssh_opts() {
  echo "-i ${SSH_KEY} -o StrictHostKeyChecking=accept-new"
}

# p2p_port/rpc_port/jsonrpc_port/ws_port <node-index> — pystarport's own
# base_port + i*10 offset scheme (p2p=+0, rpc=+7, json-rpc=+1, ws=+2).
p2p_port() { echo $((BASE_PORT + $1 * 10)); }
rpc_port() { echo $((BASE_PORT + $1 * 10 + 7)); }
jsonrpc_port() { echo $((BASE_PORT + $1 * 10 + 1)); }
ws_port() { echo $((BASE_PORT + $1 * 10 + 2)); }
